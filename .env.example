# Testnet and dry-run are deliberately the defaults.
HL_NETWORK=testnet
HL_DRY_RUN=true
HL_COIN=BTC
HL_SIDE=forward
HL_ACCOUNT_ADDRESS=
HL_SECRET_KEY=
HL_LEVERAGE=1
HL_MARGIN_MODE=cross

# Position sizes are in the coin's base unit.
HL_TAP=0.02
HL_LIMIT_SIZE=0.08
HL_T_GUIDE=0
HL_LIMIT_SPREAD=0.0005
# Hyperliquid candle interval: 1m, 3m, 5m, 15m, 30m, 1h, 2h, 4h,
# 8h, 12h, 1d, 3d, 1w, or 1M.
HL_TIMEFRAME=5m
HL_ALL_IN=false
